# 1. Σύνθεση (VHDL -> JSON) μέσω GHDL plugin
#================================================
# Conversion of vhdl into verilog
#================================================


$(FILENAME_V).ghdl.v : $(VT100_VHDL_SOURCES) $(VT100_TOP_VHDL)
	$(GHDL_CMD) analyze $(GHDL_FLAGS) $^
	$(GHDL_CMD) synth $(GHDL_FLAGS) -Wno-nowrite --out=verilog $(VT100_TOP_MODULE) > $@ #syntax for ghdl 5.0.0

# Note : Need to post-process the verilog generated by GHDL
# - remove the $fatal() tasks because Yosys does not accept these tasks
SEDOPS = -e 's/\$$fatal[^\)]*\)//g'	

$(FILENAME_V) : $(FILENAME_V).ghdl.v
	cat $< | sed -E $(SEDOPS) > $@

#================================================
# Synthesis with yosys
#================================================

FILENAME_JSON = $(TOP).json

# Note : Parameters that should improve quality of results, but not recommended for embedded synthesis : -flatten -abc9
YOSYS_SYNTH_FLAGS = -widemux 5

# Note : If using abc9, need to set the intended clock period (in ps) with this command : scratchpad -set abc9.D <ps>
$(JSON) : $(VT100_VHDL_SOURCES) $(VT100_TOP_VHDL)
	mkdir -p $(BUILD_DIR)
