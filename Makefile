	./tools/gvi -vv $(VERILATOR_VERSION) -v $(PLLE2_FILES) -t PLLE2_ADV_WRAPPER -o --timing -c CLKIN1  # -Gportsize=$(PORTSIZE) # use general option forwarding to set portsize
